/* 求职辅导页面样式 */
.container {
  min-height: 100vh;
  background: #0d1117;
  padding: 32rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #e6edf3;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #8b949e;
}

/* 内容区块 */
.sections {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.section-card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 36rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #e6edf3;
}

.section-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.content-item {
  font-size: 26rpx;
  color: #c9d1d9;
  line-height: 1.7;
  padding-left: 8rpx;
}

/* 二维码区域 */
.qrcode-section {
  margin-bottom: 40rpx;
}

.qrcode-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #e6edf3;
  text-align: center;
  margin: 32rpx 0 24rpx;
}

.qrcode-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.qrcode-card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.qrcode-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background: #fff;
  flex-shrink: 0;
}

.qrcode-info {
  flex: 1;
}

.qrcode-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #e6edf3;
  margin-bottom: 8rpx;
}

.qrcode-desc {
  font-size: 24rpx;
  color: #8b949e;
  line-height: 1.5;
}

.qrcode-tip {
  font-size: 22rpx;
  color: #484f58;
  text-align: center;
  margin-top: 16rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #21262d;
  margin: 16rpx 0;
}

/* 底部 */
.footer {
  padding-bottom: 40rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #484f58;
  text-align: center;
  padding-top: 24rpx;
}
