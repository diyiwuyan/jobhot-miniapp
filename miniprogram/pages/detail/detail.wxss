.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e6edf3;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.detail-section {
  margin: 8rpx 0;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8b949e;
  margin-bottom: 12rpx;
}

.detail-summary {
  font-size: 28rpx;
  color: #e6edf3;
  line-height: 1.8;
  white-space: pre-wrap;
}

.detail-source {
  font-size: 26rpx;
  color: #e6edf3;
}

.detail-actions {
  margin-top: 16rpx;
}

.detail-actions .btn-primary {
  width: 100%;
  display: block;
  margin-bottom: 20rpx;
}

/* 分享按钮样式 - 覆盖 button 默认样式 */
.btn-share {
  width: 100% !important;
  display: block;
  background: #21262d !important;
  color: #8b949e !important;
  border: 1rpx solid #30363d !important;
  border-radius: 12rpx !important;
  padding: 20rpx 40rpx !important;
  font-size: 28rpx !important;
  text-align: center;
  line-height: 1.5 !important;
  margin: 0 !important;
}

.btn-share::after {
  border: none;
}

.btn-share:active {
  opacity: 0.85;
}

.web-tip {
  padding: 40rpx 0;
}
