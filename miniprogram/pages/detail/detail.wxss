/* 详情页顶部操作栏 */
.detail-topbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.favorite-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #8b949e;
  background: #21262d;
  border: 1rpx solid #30363d;
}

.favorite-btn.favorited {
  color: #f0883e;
  background: rgba(240, 136, 62, 0.1);
  border-color: rgba(240, 136, 62, 0.3);
}

/* 标题 */
.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e6edf3;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* 标签区 */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.detail-extra-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.extra-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(88, 166, 255, 0.08);
  color: #58a6ff;
  border: 1rpx solid rgba(88, 166, 255, 0.2);
}

/* 信息卡片网格 */
.info-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 8rpx 0;
}

.info-card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  padding: 20rpx;
}

.info-label {
  font-size: 22rpx;
  color: #8b949e;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #e6edf3;
  font-weight: 500;
}

.info-value.warn {
  color: #f0883e;
}

/* 详情区 */
.detail-section {
  margin: 8rpx 0;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8b949e;
  margin-bottom: 12rpx;
}

.detail-summary {
  font-size: 28rpx;
  color: #e6edf3;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 操作按钮 */
.detail-actions {
  margin-top: 24rpx;
}

.detail-actions .btn-primary {
  width: 100%;
  display: block;
  margin-bottom: 20rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-row .btn-secondary {
  flex: 1;
  background: #21262d !important;
  color: #c9d1d9 !important;
  border: 1rpx solid #30363d !important;
  border-radius: 12rpx !important;
  padding: 20rpx 0 !important;
  font-size: 26rpx !important;
  text-align: center;
  line-height: 1.5 !important;
  margin: 0 !important;
}

.action-row .btn-secondary::after {
  border: none;
}

/* 分享按钮 */
.action-row .btn-share {
  flex: 1;
  background: #21262d !important;
  color: #8b949e !important;
  border: 1rpx solid #30363d !important;
  border-radius: 12rpx !important;
  padding: 20rpx 0 !important;
  font-size: 26rpx !important;
  text-align: center;
  line-height: 1.5 !important;
  margin: 0 !important;
}

.action-row .btn-share::after {
  border: none;
}

.action-row .btn-secondary:active,
.action-row .btn-share:active {
  opacity: 0.85;
}

/* 网页版提示 */
.web-tip {
  padding: 40rpx 0;
}
