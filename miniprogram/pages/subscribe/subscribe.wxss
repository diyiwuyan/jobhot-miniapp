.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #e6edf3;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e6edf3;
  margin-bottom: 16rpx;
}

.form-input {
  background: #0d1117;
  border: 1rpx solid #30363d;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #e6edf3;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  background: #0d1117;
  border: 1rpx solid #30363d;
  color: #8b949e;
}

.chip.active {
  background: rgba(88, 166, 255, 0.1);
  border-color: rgba(88, 166, 255, 0.4);
  color: #58a6ff;
}

.subscribe-section {
  margin-top: 48rpx;
  padding: 0 8rpx;
}

.subscribe-status {
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.subscribe-status.success {
  background: rgba(63, 185, 80, 0.08);
  color: #3fb950;
  border: 1rpx solid rgba(63, 185, 80, 0.2);
}

.subscribe-btn {
  width: 100% !important;
  margin: 0;
}
