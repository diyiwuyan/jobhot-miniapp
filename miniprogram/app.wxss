/* 全局样式 - 暗色主题，与 jobhot 网站风格一致 */
page {
  background-color: #0d1117;
  color: #e6edf3;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx 32rpx;
}

/* 卡片 */
.card {
  background: #161b22;
  border: 1rpx solid #21262d;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card:active {
  background: #1c2128;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: rgba(88, 166, 255, 0.1);
  color: #58a6ff;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-green {
  background: rgba(63, 185, 80, 0.1);
  color: #3fb950;
}

.tag-orange {
  background: rgba(210, 153, 34, 0.1);
  color: #d29922;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #58a6ff, #3b82f6);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: #21262d;
  color: #8b949e;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  text-align: center;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #21262d;
  margin: 24rpx 0;
}

/* 文字颜色 */
.text-muted {
  color: #8b949e;
}

.text-accent {
  color: #58a6ff;
}

.text-success {
  color: #3fb950;
}

.text-warning {
  color: #d29922;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
  color: #8b949e;
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
